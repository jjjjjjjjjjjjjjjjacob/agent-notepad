# Local development and Vercel previews share this hosted development backend.
APP_ENV=development
CONVEX_DEPLOYMENT=dev:incredible-boar-27
NEXT_PUBLIC_CONVEX_URL=https://incredible-boar-27.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://incredible-boar-27.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3843
# Next.js server only: public AuthKit origin used to serve /auth.md and discovery.
# Enable Agent Registration in the WorkOS environment first.
WORKOS_AUTHKIT_DOMAIN=
# Set these on the Convex deployment, not in the browser:
# SITE_URL=https://dev.agentnotepad.com
# TRUSTED_ORIGINS=https://dev.agentnotepad.com,http://localhost:3843,http://127.0.0.1:3843
# BETTER_AUTH_SECRET=<cryptographically-random-secret>
# EMBEDDING_SERVICE_URL=https://your-embedding-service.example
# EMBEDDING_SERVICE_TOKEN=<shared-secret-set-on-the-embedding-service>
# INDEXNOW_KEY=
# WorkOS identity: set on the Convex deployment using `bunx convex env set`.
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_AUTHKIT_ISSUER=<exact issuer from AuthKit authorization-server metadata>
# WORKOS_AGENT_AUDIENCE=<expected audience; defaults to WORKOS_CLIENT_ID>
# Shared Convex authentication admissions per 60-second window, integer 1–10000.
# WORKOS_AUTH_MAX_ATTEMPTS_PER_MINUTE=1200
# Direct agent purchases: secret values belong on Convex, never NEXT_PUBLIC_*.
# See docs/COMMERCE.md; `bun run stripe:setup --apply --deployment NAME`
# creates the webhook and sets these values from your private env file.
# STRIPE_SECRET_KEY=sk_test_... (or sk_live_... for real payments)
# STRIPE_WEBHOOK_SECRET=whsec_... (setup creates this for a new endpoint)
# SITE_URL=https://your-frontend.example
# Optional explicit override; defaults to NEXT_PUBLIC_CONVEX_SITE_URL + /stripe/webhook.
# STRIPE_WEBHOOK_URL=https://your-deployment.convex.site/stripe/webhook
# Needed only for direct Link agent shared-payment tokens, not hosted Checkout:
# STRIPE_AGENT_PROFILE_ID=<your Stripe business profile ID>
# Legacy test-only quota billing, not required for direct purchases:
# STRIPE_PRICE_ID=

# Moderation rollout: leave off until docs/MODERATION.md acceptance checks pass.
MODERATION_ENABLED=false
# Matching Next.js + Convex server secret; generate at least 32 random bytes.
MODERATION_GATEWAY_SECRET=
# Next.js server only; a separate key for exact-IP HMACs.
MODERATION_IP_SECRET=
# Convex server configuration:
# MODERATION_ADMIN_USER_IDS=<comma-separated authenticated human IDs>
# MODERATION_GUARDRAIL_ID=
# MODERATION_GUARDRAIL_VERSION=<pinned published integer, never DRAFT>
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MODERATION_SCAN_ONLY=false

# Place is an isolated simulated marketplace. No live provider is implemented.
# Default off. Set PLACE_ENABLED=true in BOTH Next.js and Convex to expose it.
PLACE_ENABLED=false
PLACE_MODE=sandbox
PLACE_SANDBOX_MAX_SELLERS=32
# Explicit Better Auth human IDs, comma-separated (configure in Convex).
PLACE_OPERATOR_OWNER_IDS=
# Optional signed sandbox callbacks (configure a secret in Convex).
PLACE_SANDBOX_WEBHOOK_SECRET=

# Vercel Preview, scoped to the dev Git branch only (never local or other branches):
# NEXT_PUBLIC_SITE_URL=https://dev.agentnotepad.com
# CONVEX_DEPLOY_KEY=<dev:incredible-boar-27 key with deployment:deploy and deployment:data:view>

# Production-only settings (Vercel Production / matching Convex environment):
# NEXT_PUBLIC_SITE_URL=https://agentnotepad.com
# NEXT_PUBLIC_CONVEX_SITE_URL=https://api.agentnotepad.com
# NEXT_PUBLIC_CONVEX_URL=https://gregarious-chickadee-782.convex.cloud
# CONVEX_DEPLOY_KEY=<production key with deployment:deploy and deployment:data:view>
# PUBLIC_SUPPORT_EMAIL=<operator-monitored public contact>
# Independent of automated content moderation; set true on Next.js AND Convex.
WRITE_GATEWAY_REQUIRED=false
# Recovery jobs: encrypted artifacts only; store key separately from ciphertext.
# BACKUP_ENCRYPTION_KEY=<32-byte hex key>

# PostHog: opt-in browser collection and separate agent API telemetry.
# See docs/ANALYTICS.md. Keep development and previews off.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED=false
NEXT_PUBLIC_POSTHOG_VERIFICATION=false
# Optional comma-separated approved values shared by utm_source/medium/campaign.
NEXT_PUBLIC_ANALYTICS_CAMPAIGNS=
# Set matching server values on Vercel AND the production Convex deployment.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_VERIFICATION=false
# Dashboard provisioning only; never expose a personal key in NEXT_PUBLIC_*.
# POSTHOG_PROJECT_ID=596153
# POSTHOG_PERSONAL_API_KEY=
