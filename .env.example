# Local development and Vercel previews share this hosted development backend.
APP_ENV=development
CONVEX_DEPLOYMENT=dev:incredible-boar-27
NEXT_PUBLIC_CONVEX_URL=https://incredible-boar-27.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://incredible-boar-27.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3843
# Next.js server only: public AuthKit origin used to serve /auth.md and discovery.
# Enable Agent Registration in the WorkOS environment first.
WORKOS_AUTHKIT_DOMAIN=
# Set these on the Convex deployment, not in the browser:
# SITE_URL=https://agent-notepad-development.vercel.app
# TRUSTED_ORIGINS=https://agent-notepad-development.vercel.app,http://localhost:3843,http://127.0.0.1:3843
# BETTER_AUTH_SECRET=<cryptographically-random-secret>
# EMBEDDING_SERVICE_URL=https://your-embedding-service.example
# EMBEDDING_SERVICE_TOKEN=<shared-secret-set-on-the-embedding-service>
# INDEXNOW_KEY=
# WorkOS / Stripe prototype: set on the Convex deployment using `bunx convex env set`.
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_AUTHKIT_ISSUER=<exact issuer from AuthKit authorization-server metadata>
# WORKOS_AGENT_AUDIENCE=<expected audience; defaults to WORKOS_CLIENT_ID>
# Shared Convex authentication admissions per 60-second window, integer 1–10000.
# WORKOS_AUTH_MAX_ATTEMPTS_PER_MINUTE=1200
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Moderation rollout: leave off until docs/MODERATION.md acceptance checks pass.
MODERATION_ENABLED=false
# Matching Next.js + Convex server secret; generate at least 32 random bytes.
MODERATION_GATEWAY_SECRET=
# Next.js server only; a separate key for exact-IP HMACs.
MODERATION_IP_SECRET=
# Convex server configuration:
# MODERATION_ADMIN_USER_IDS=<comma-separated authenticated human IDs>
# MODERATION_GUARDRAIL_ID=
# MODERATION_GUARDRAIL_VERSION=<pinned published integer, never DRAFT>
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MODERATION_SCAN_ONLY=false

# Place is an isolated simulated marketplace. No live provider is implemented.
# Default off. Set PLACE_ENABLED=true in BOTH Next.js and Convex to expose it.
PLACE_ENABLED=false
PLACE_MODE=sandbox
PLACE_SANDBOX_MAX_SELLERS=32
# Explicit Better Auth human IDs, comma-separated (configure in Convex).
PLACE_OPERATOR_OWNER_IDS=
# Optional signed sandbox callbacks (configure a secret in Convex).
PLACE_SANDBOX_WEBHOOK_SECRET=
